{
  "id": "official.bilibili",
  "name": "Bilibili",
  "author": {
    "name": "putyy",
    "url": "https://github.com/putyy/resd-plugin-bilibili"
  },
  "locales": {
    "zh-CN": {
      "name": "哔哩哔哩",
      "description": "从哔哩哔哩视频详情页识别并合并下载视频与音频。"
    },
    "zh": {
      "name": "哔哩哔哩",
      "description": "从哔哩哔哩视频详情页识别并合并下载视频与音频。"
    },
    "en": {
      "name": "Bilibili",
      "description": "Captures video and audio tracks from Bilibili video detail pages and merges them for download."
    }
  },
  "version": "1.0.1",
  "apiVersion": 1,
  "runtime": "javascript",
  "entry": "main.js",
  "priority": 1800,
  "requires": {
    "ffmpeg": ">=6.0"
  },
  "permissions": {
    "domains": [
      "www.bilibili.com",
      "api.bilibili.com",
      "*.bilivideo.com",
      "*.bilivideo.cn",
      "*.hdslb.com"
    ],
    "capabilities": [
      "observe-response",
      "read-response-body",
      "emit-resource",
      "media.basic"
    ],
    "bodyLimit": 8388608
  },
  "match": [
    {
      "stage": "response",
      "host": "www.bilibili.com",
      "path": "/video/*",
      "readBody": true,
      "contentTypes": ["text/html", "text/html;*"]
    },
    {
      "stage": "response",
      "host": "api.bilibili.com",
      "path": "/x/web-interface/view*",
      "readBody": true,
      "contentTypes": ["application/json", "application/json;*"]
    },
    {
      "stage": "response",
      "host": "api.bilibili.com",
      "path": "/x/player/*playurl*",
      "readBody": true,
      "contentTypes": ["application/json", "application/json;*"]
    },
    {
      "stage": "response",
      "host": "*.bilivideo.com",
      "path": "*.m4s",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "*.bilivideo.cn",
      "path": "*.m4s",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "api.bilibili.com",
      "path": "/x/v2/dm/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "api.bilibili.com",
      "path": "/x/v2/subtitle/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "*.hdslb.com",
      "path": "/bfs/*",
      "readBody": false
    }
  ],
  "resourceKinds": [
    {
      "id": "media.video",
      "icon": "video",
      "color": "#00aeec",
      "locales": {
        "zh": {"name": "视频"},
        "en": {"name": "Video"}
      }
    }
  ]
}
